#!/bin/bash
# mutex timeout run
# execute command under mutex control and detect hang upon timeout
# exits after timeout leaving process running or try to kill it (-k/-s)
# do not allow new command execution if command still running
# displays stdout/stderr of command with exit code / elapse time when not timed out
# next run after hang ends displays the last hang command output / result
# return code is command return code except :
# timeout exceeded: 124
# command still running: 123
#
# run a mutex command:
# mxtrun [-t <timeout> [-k|-s <signal>]] [-f] <mutex> <command> <args>
# kill a mutex still running:
# mxtrun -k|-s <signal> <mutex>
#

usage() {
    cat - >&$(($1+1)) <<'EOF'
usage: mxtrun [-t timeout [-k|-s <signal>]] [-f] <mutex> <command> <args>
       mxtrun -k|-s <signal> <mutex>

parameters:
   -t <timeout> : in seconds, time to wait before exiting
                  default no timeout (0)
   -k           : kill command if timeout exceeded or immediately if no timeout
   -s <signal>  : kill -<signal> command if timeout exceeded or immediately
   -f           : follow run displaying stdout/stderr during run
   <mutex>      : name of the mutex to use
EOF
    exit "$1"
}

die() {
    local e=$1
    shift
    echo "mxtrun: $*" >&2
    exit $e;
}

opts='hfks:t:'
kill=0
signal='TERM'
tmout=0
follow=0
killonly=0
while getopts "$opts" opt;do
    case "$opt" in
      t) tmout="$OPTARG";;
      f) follow=1;;
      s) signal="$OPTARG";kill=1;;
      k) kill=1;;
      h) usage 0;;
      *) usage 1;;
    esac
done
shift $((OPTIND-1))
(($#)) || usage 1
name="$1"
shift
[[ $tmout =~ ^[0-9]+(\.[0-9]+)?$ ]]   || die 2 "invalid timeout: $tmout"
[[ $name  =~ ^[A-Za-z0-9._-]+$ ]]     || die 2 "invalid mutex name: $name"
[[ $signal =~ ^[A-Za-z0-9]+$ ]]       || die 2 "invalid signal: $signal"
[[ $tmout =~ ^0+(\.0+)?$ ]] && tmout=0
nargs='> 0'
((kill)) && [ "$tmout" = 0 ] && killonly=1 && nargs='== 0'
(($# $nargs)) || usage 1
mpath="${XDG_RUNTIME_DIR:-/tmp}/.mxtrun.$(id -u)"
mkdir -m 700 -p -- "$mpath" && [[ -O $mpath && ! -L $mpath ]] || die 2 "unsafe state dir"
cmdf="$mpath/$name"
lockme() {
    for _ in 1 2 3;do
        eval "exec $1<>"'"$cmdf.$2"' || die 2 "cannot open lock file $cmdf.$2"
        flock -n -E 123 "$1" || {
            [ $? = 123 ] || die 2 "issue locking $cmdf.$2"
            die 123 "already running on mutex $name"
        }
        [[ /dev/fd/$1 -ef $cmdf.$2 ]] && return 0
    done
    die 2 "race locking issue"
}

show_cmd() {
    [ -f "$cmdf.cmd" ] && echo "command: $(<"$cmdf.cmd")"
    [ -f "$cmdf.pid" ] && echo "started: $(date -r "$cmdf.pid" '+%F %T')"
}
tmout_out() {
    ((follow)) && kill "${tails[@]}"
    { echo ;echo "mxtrun: timeout ${tmout}s exceeded on $name"; }>&2
    ((hang)) && echo "mxtrun: command still running" >&2 || \
                echo "mxtrun: command terminated" >&2
    show_cmd >&2
    ((follow==0)) && {
        ((hang)) && echo "output so far:" >&2 || echo "output:" >&2
        cat "$cmdf.out"
        cat "$cmdf.err" >&2
    }
    cat "$cmdf.time" >&2
}
kill_check() {
    flock -w 1 5 || hang=1
    tmout_out
    ((hang)) || rm -f -- "$cmdf".{out,err,time,cmd,pid,lock,mx}
    return $hang
}
kill_cmd() {
    local sid pid
    show_cmd
    [ -s "$cmdf.pid" ] || { echo "mxtrun: no process found to kill"; return 1; }
    flock -n 5 && {
        echo "mxtrun: no more process running on mutex $name"
        cat "$cmdf".{out,err,time} 2>/dev/null 
        rm -f -- "$cmdf".{out,err,time,cmd,pid,lock,mx}
        return 1
    }
    pid=$(<"$cmdf.pid")
    [[ $pid =~ ^[0-9]+$ ]] && ((pid>1)) || { echo "mxtrun: bad pid found"; return 1; }
    sid=$(pgrep -oP $pid) || { echo "mxtrun: no process found to kill"; return 1; }
    echo "mxtrun: killing $sid"
    kill "-$signal" -- -$sid
    kill_check
}
((killonly)) && {
    [ -e "$cmdf.lock" ] || die 2 "mutex $name not found"
    exec 5<"$cmdf.lock" || die 2 "cannot open lock file $cmdf.lock"
    kill_cmd || exit 1
    exit 0
}
[[ -x /usr/bin/time ]] || die 2 "GNU time (/usr/bin/time) required"
lockme 4 mx
lockme 5 lock
[ -f "$cmdf.out" ] && {
    echo "mxtrun: previous timeout result on $name"
    show_cmd
    echo "output:"
    cat "$cmdf".{out,err,time} 2>/dev/null
    echo "-------"
} >&2
printf '%q ' "$@" >"$cmdf.cmd"
export TIME='exit: %x - elapse: %E - user: %U - sys: %S'
: >"$cmdf.out"; : >"$cmdf.err"; : >"$cmdf.pid"; >"$cmdf.time"
if ((kill));then
    nohup /usr/bin/time -o "$cmdf.time" timeout -s "$signal" "$tmout" "$@" >"$cmdf.out" 2>"$cmdf.err" 4>&- </dev/null &
else
    nohup /usr/bin/time -o "$cmdf.time" setsid "$@" >"$cmdf.out" 2>"$cmdf.err" 4>&- </dev/null &
fi
pid=$!
echo "$pid" >"$cmdf.pid"
tails=()
((follow)) && {
    tail -n +0 -s 0.1 --pid=$pid -f "$cmdf.out" 4>&- 5>&- & tails+=($!)
    tail -n +0 -s 0.1 --pid=$pid -f "$cmdf.err" >&2 4>&- 5>&- & tails+=($!)
}
end_run() {
    wait $pid
    exitc=$?
    if ((follow)) ;then
        wait "${tails[@]}"
    else
        cat "$cmdf.out"
        cat "$cmdf.err" >&2
    fi
    cat "$cmdf.time" >&2
    rm -f -- "$cmdf".{out,err,time,cmd,pid,lock,mx}
    exit $exitc
}
[ "$tmout" = 0 ] && end_run
exec 5<>"$cmdf.lock" || die 2 "cannot open lock file"
flock -w "$tmout" -E 123 5 && end_run
[ $? = 123 ] || die 125 "issue locking $cmdf.lock"
((kill)) && { kill_check; exit 124; }
hang=1
tmout_out
exit 124

